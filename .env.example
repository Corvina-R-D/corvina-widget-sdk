# Corvina instance used by the dev server (yarn dev): copy this file to .env and change the values.
# Read by webpack (option dotenv of webpack.config.js): the dev server rebuilds when it changes, reload the page.
# The variables of the shell win over the file, e.g. CORVINA_HOST=corvina.io yarn dev

# Host name of the Corvina instance (default corvina.cloud)
CORVINA_HOST=corvina.cloud
# Realm of the organization to log in to (default realm, a placeholder: set the one of your organization)
CORVINA_REALM=realm
# Host of the translations, optional (default the one of Corvina)
# CORVINA_I18N_HOST=
