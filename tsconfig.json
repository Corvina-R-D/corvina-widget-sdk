{
    "compilerOptions": {
        "types": [
            "vue-typescript-import-dts",
            "node"
        ],
        "lib": [
            "dom",
            "es5",
            "es2015",
            "es6"
        ],
        "target": "es2018",
        "module": "esnext",
        "moduleResolution": "node",
        "sourceMap": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "rootDir": ".",
        "paths": {
            "@/*": [ "_corvina/src/*"], // must match webpack alias !!!
            "corvina": [ "_corvina/src/corvina-module" ],
        },
        "resolveJsonModule":true
    },
    "include": [
        "_corvina/**/*",
        "src/**/*",
        "index.ts",
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/test",
        "_corvina/test",
        // Optional example, requires lit-html (yarn add lit-html): it is compiled when imported by main.ts
        "src/examples/MyLitWidget",
    ]
}
