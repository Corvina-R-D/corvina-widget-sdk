{
  "name": "@corvina/widget-sdk",
  "description": "Corvina dashboard widget SDK",
  "version": "1.0.65",
  "author": "Corvina",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "corvina-sdk": "node cli/corvina-sdk.js",
    "build-i18n": "node ./static/template/build-i18n.js",
    "dev": "cross-env --mode=development NODE_ENV=development webpack serve --progress --mode=development --hot",
    "dev:local": "cross-env CORVINA_RUNTIME=local NODE_ENV=development webpack serve --progress --mode=development --hot",
    "build": "cross-env NODE_ENV=production webpack --progress && gulp"
  },
  "dependencies": {
    "@casl/ability": "^2.5.1",
    "atob": "^2.1.1",
    "axios": "^0.18.0",
    "base64-arraybuffer": "^0.1.5",
    "buffer": "^6.0.3",
    "chart.js": "^2.7.2",
    "circular-json": "^0.5.1",
    "clone": "^1.0.4",
    "css-element-queries": "^1.0.1",
    "javascript-natural-sort": "^0.7.1",
    "jquery": "^3.3.1",
    "jshashes": "^1.0.7",
    "jsonwebtoken": "^8.4.0",
    "leaflet": "^1.3.1",
    "leaflet-search": "^2.9.7",
    "leaflet.markercluster": "^1.3.0",
    "lodash": "^4.17.5",
    "lz-string": "^1.4.4",
    "mapbox-gl": "^0.41.0",
    "moment": "^2.22.0",
    "phoenix": "^1.3.0",
    "phoenix-channels": "^1.0.0",
