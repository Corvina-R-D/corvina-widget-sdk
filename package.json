    "vue-breadcrumbs": "^1.1.2",
    "vue-chartjs": "^3.3.1",
    "vue-color": "^2.6.0",
    "vue-deepset": "^0.6.3",
    "vue-infinite-loading": "^2.3.3",
    "vue-material": "^1.0.0-beta-10.2",
    "vue-router": "^3.0.1",
    "vuetify": "^2.3.7",
    "vuex": "^3.0.1"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "devDependencies": {
    "@babel/cli": "^7.15.3",
    "@babel/core": "^7.15.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@types/jest": "^23.3.13",
    "@types/mocha": "^5.2.5",
    "@types/node": "^10.3.6",
    "@vue/test-utils": "^1.0.0-beta.11",
    "@webpack-cli/serve": "^3.0.1",
    "babel-jest": "^26.0.1",
    "babel-loader": "^8.2.1",
    "compression-webpack-plugin": "^11.0.0",
    "cross-env": "^5.1.4",
    "css-loader": "^1.0.0",
    "esbuild-loader": "^2.15.1",
    "file-loader": "^1.1.4",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "gulp": "^4.0.2",
    "gulp-zip": "^5.0.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^23.1.0",
    "jest-css-modules": "^1.1.0",
    "jest-serializer-vue": "^0.3.0",
    "jest-vue-preprocessor": "^1.3.1",
    "pug": "^2.0.3",
    "pug-plain-loader": "^1.0.0",
    "script-loader": "^0.7.2",
    "ts-jest": "^26.5.5",
    "ts-loader": "^8.0.9",
    "typescript": "^5.9.3",
    "uglifyjs-webpack-plugin": "^2.1.3",
    "vue-jest": "^4.0.1",
    "vue-loader": "^15.9.8",
    "vue-template-compiler": "^2.6.14",
    "vue-typescript-import-dts": "^4.0.0",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^3.3.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.0.0"
  },
  "jest": {
    "testMatch": [
      "**/src/test/**/*.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "ts",
      "json",
      "vue",
      "node"
    ],
    "transform": {
      "^.+\\.js$": "<rootDir>/node_modules/babel-jest",
      ".*\\.(vue)$": "<rootDir>/node_modules/vue-jest",
      ".(ts|tsx)": "<rootDir>/node_modules/ts-jest/preprocessor.js"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css)$": "<rootDir>/node_modules/jest-css-modules"
    },
    "snapshotSerializers": [
      "<rootDir>/node_modules/jest-serializer-vue"
    ],
    "mapCoverage": true,
    "collectCoverageFrom": [
      "**/src/classes/**.js",
      "**/src/classes/**.ts",
      "**/src/components/**",
      "**/src/store/**"
    ]
  },
  "engines": {
    "node": "22.3.0"
  },
  "packageManager": "yarn@4.18.1+sha512.107f80e13c40b41597284d03190c56f41a3d72b5c72c9ef799fc634d026ebfc5e89cd5964e97a2f014392637331c9354f4644e4f27303059fc88ebd12195d470"
}
